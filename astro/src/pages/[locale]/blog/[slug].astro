---
import Base from '../../../layouts/Base.astro';
import { entries } from '../../../lib/content';
import { LOCALES } from '../../../lib/i18n';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of LOCALES) {
    for (const entry of await entries('blog', locale)) {
      paths.push({ params: { locale, slug: entry.slug }, props: { entry } });
    }
  }
  return paths;
}

const { locale } = Astro.params;
const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof entries>>[number] };
const { Content } = await render(entry);
---
<Base title={entry.data.title} locale={locale!}>
  <section class="hero">
    <h1>{entry.data.title}</h1>
    {entry.data.date && <p class="muted">{entry.data.date}</p>}
  </section>
  <main>
    <article>
      <Content />
    </article>
  </main>
</Base>
